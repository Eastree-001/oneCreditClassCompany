# 开发环境配置文件模板
# 复制此文件为 .env 并填写实际配置值

# API 基础地址
VITE_API_BASE_URL=http://localhost:8082/api

# 应用配置
VITE_APP_TITLE=一学分课堂企业版
VITE_APP_VERSION=1.0.0

# 阿里云OSS配置
# 请替换为实际的阿里云OSS配置信息
VITE_OSS_REGION=oss-cn-hangzhou
VITE_OSS_BUCKET=your-bucket-name
VITE_OSS_ACCESS_KEY_ID=your-access-key-id
VITE_OSS_ACCESS_KEY_SECRET=your-access-key-secret

# 其他可选配置
# VITE_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# VITE_OSS_SECURE=true